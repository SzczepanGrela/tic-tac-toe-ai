ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# This image is used only by the manually approved deployment safety check.
# The service keeps running, while both the image-owned and Coolify-managed
# health-check commands fail.
COPY --chown=10001:10001 infra/deployment-safety/healthcheck.py /app/web/healthcheck.py

HEALTHCHECK --interval=5s --timeout=2s --start-period=0s --retries=120 \
  CMD ["python", "-m", "web.healthcheck"]
